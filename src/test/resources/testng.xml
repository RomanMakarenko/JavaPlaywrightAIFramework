<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Single entry point for the whole framework (surefire <suiteXmlFiles> points here).
    Phase 6 — running model:

      mvn clean test                      # everything: parallel methods, all groups (smoke + regression)
      mvn test -Dgroups=smoke             # fast PR feedback — smoke group only
      mvn test -Dgroups=regression        # slower, deeper coverage
      mvn test -Dtest=LoginTest           # single class
      mvn test -Dtest=LoginTest#method    # single method
      BROWSER=firefox HEADLESS=false mvn test   # env-driven config (see README)

    Group model: the suite deliberately applies NO <groups><run> filter, so the default run
    exercises every group. Filtering is done with the surefire -Dgroups property, which TestNG
    honours even when a suite XML is configured (verified 2026-08-23). To pin the suite to one
    group in XML instead, uncomment:

      <groups><run><include name="smoke"/></run></groups>
-->

<suite name="JavaPlaywrightAIFramework" parallel="methods" thread-count="4">

    <!--
        Suite-wide listeners. allure-testng's own listener is registered via ServiceLoader
        (META-INF/services in the allure-testng jar) and needs no XML entry.
          - ScreenshotOnFailureListener : full-page PNG attached to Allure on test failure
          - AllureTestListener          : writes environment.properties at suite start
          - RetryListener               : wires RetryAnalyzer (config-driven) to every @Test
          - JiraBugListener             : files a Jira Bug ticket + screenshot on failure (Phase 15,
                                          no-op unless jira.tickets.enabled and creds are configured)
    -->
    <listeners>
        <listener class-name="com.funtime.listeners.ScreenshotOnFailureListener"/>
        <listener class-name="com.funtime.listeners.AllureTestListener"/>
        <listener class-name="com.funtime.listeners.RetryListener"/>
        <listener class-name="com.funtime.listeners.JiraBugListener"/>
    </listeners>

    <!--
        Hermetic framework sanity check: navigates about:blank, never touches the network, so it
        must pass even when funtime.com.ua is unreachable.
    -->
    <test name="Framework sanity (hermetic)">
        <classes>
            <class name="com.funtime.tests.BaseTestIsolationTest"/>
        </classes>
    </test>

    <!-- Real-app E2E against https://funtime.com.ua/ — all through Page Objects. -->
    <test name="funtime.com.ua E2E">
        <classes>
            <class name="com.funtime.tests.FuntimeSiteSmokeTest"/>
            <class name="com.funtime.tests.LoginTest"/>
            <class name="com.funtime.tests.SiteJourneyTest"/>
        </classes>
    </test>
</suite>